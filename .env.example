# This site reads no application secrets.
# Names below are optional. Values are placeholders.

# Disables Next.js telemetry in local runs. CI and the container set this too.
NEXT_TELEMETRY_DISABLED=1

# The container listens on PORT. `pnpm start` uses port 3001 instead.
PORT=3000

# Optional path to the API OpenAPI document when regenerating the reference.
# Do not commit that file. See README.
# OPENAPI_SPEC=./openapi.source.json

# Applies only to Dockerfile (BuildKit <dockerfile>.dockerignore).
# Keep the build context to source. pnpm install and next build run inside the image.
**/node_modules
**/.next
**/dist
**/out
**/build
**/coverage
**/.turbo
**/.source
.git

# Credentials and the full API spec (non-public routes) stay out of every layer.
**/.env
**/.env.*
!**/.env.example
openapi.source.json

**/*.log
**/.DS_Store
